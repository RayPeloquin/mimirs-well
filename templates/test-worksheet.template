<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"><title>Crucible offline test worksheet</title><style>
:root{color-scheme:dark}*{box-sizing:border-box}body{background:#0d171a;color:#eff4e9;font:16px/1.6 system-ui,sans-serif;max-width:800px;margin:auto;padding:24px;overflow-wrap:anywhere}h1,h2{font-family:Georgia,serif;font-weight:400}h1{font-size:clamp(30px,7vw,48px)}section{border:1px solid #415950;border-radius:8px;padding:16px;margin:16px 0;background:#16272a}label{display:block;margin:12px 0 4px}textarea,input:not([type=checkbox]),select{width:100%;min-width:0}textarea,input,select,button{font:inherit;background:#101d20;color:inherit;border:1px solid #6b847c;border-radius:6px;padding:10px;max-width:100%}button{min-height:44px;margin:8px 4px 0 0;cursor:pointer;white-space:normal}button:disabled{opacity:.5;cursor:not-allowed}textarea{resize:vertical}pre{white-space:pre-wrap;overflow-wrap:anywhere}dt{font-weight:bold;color:#d9c398}dd{margin:0 0 12px}p.warning{border-left:3px solid #d9c398;padding-left:12px;color:#e2ceaa}[hidden]{display:none!important}
</style></head><body><h1>Crucible test worksheet</h1><p>Freeze a plan. Report a run. Preserve the distinction.</p><section id="locked"><p>This worksheet is disabled on websites. Download the blank tool and open the local file outside the public repository. JavaScript is required.</p></section><main id="work" hidden><p class="warning">Synthetic checks only. No execution, safety approval, automatic publication, encryption or autosave. Exports are local readable JSON. Save before closing. A reported run is not independently verified.</p><p id="status" role="status" aria-live="polite"></p><section><h2>1. Choose and freeze</h2><label for="task">Proposed test</label><select id="task"></select><dl id="details"></dl><label for="source">Exact source revision(s) and implementation hash / file references</label><textarea id="source" rows="3"></textarea><label for="environment">Environment, dependencies and execution command</label><textarea id="environment" rows="3"></textarea><label for="inputs">Exact inputs, dataset or seeds; implementation and oracle details</label><textarea id="inputs" rows="3"></textarea><label for="criteria">Additional frozen numeric thresholds, coverage and uncertainty method (or explain not applicable; cannot loosen the published rule)</label><textarea id="criteria" rows="3"></textarea><label><input type="checkbox" id="ready"> I have reviewed the plan, prerequisites, stop conditions and synthetic-only boundary; I have not inspected outcomes for this run.</label><button id="freeze" disabled>Freeze and export plan</button><button id="reset">Start another plan</button><button id="open">Open an exported plan</button><input id="import" type="file" accept=".json,application/json" hidden><p id="pin"></p><label><input type="checkbox" id="saved" disabled> I saved the frozen plan before inspecting outcomes.</label></section><section id="result" hidden><h2>2. Record reported outcome</h2><label for="outcome">Outcome against frozen criteria</label><select id="outcome"><option value="">Choose</option><option value="supports">Supports this limited check</option><option value="contrary">Contrary / failed check</option><option value="inconclusive">Inconclusive</option><option value="not-run">Not run</option></select><label for="observations">Actual observations, including denominators and failed controls (or why not run)</label><textarea id="observations" rows="4"></textarea><label for="artifacts">Output files, hashes or evidence references (or none and why)</label><textarea id="artifacts" rows="3"></textarea><label for="deviations">Deviations from frozen plan and limitations; state none if applicable</label><textarea id="deviations" rows="3"></textarea><label><input type="checkbox" id="honest"> This is my reported outcome, not independent verification. Missing data and deviations are disclosed.</label><button id="export" disabled>Export reported-run receipt</button></section></main><script>
(()=>{"use strict";if(location.protocol!=="file:")return;
const queue=/*QUEUE_DATA*/null;
const $=id=>document.getElementById(id), fields=["source","environment","inputs","criteria"],results=["observations","artifacts","deviations"];
let frozen=null,busy=false;
$("locked").hidden=true;$("work").hidden=false;
const status=s=>$("status").textContent=s;
for(const t of queue.tasks)$("task").add(new Option(t.title,t.id));
function task(){return queue.tasks.find(t=>t.id===$("task").value);}
function details(){const t=task();$("details").replaceChildren();for(const [k,v] of Object.entries({Priority:t.priority,Status:t.status,Question:t.question,Baseline:t.baseline,Fixture:t.fixture,Metric:t.metric,Acceptance:t.accept,Contrary:t.contrary,Stop:t.stop,Boundary:t.scope,Equipment:t.equipment,Cost:t.cost})){const dt=document.createElement("dt"),dd=document.createElement("dd");dt.textContent=k;dd.textContent=v;$("details").append(dt,dd);}}
function complete(){return fields.every(k=>$(k).value.trim());}
function update(){ $("freeze").disabled=busy||!!frozen||!complete()||!$("ready").checked; $("result").hidden=!frozen||!$("saved").checked; $("export").disabled=busy||!frozen||!$("saved").checked||!$("honest").checked||!$("outcome").value||!results.every(k=>$(k).value.trim());}
function disableFields(disabled){for(const k of ["task",...fields,"ready"])$(k).disabled=disabled;}
function clearResults(){for(const k of results)$(k).value="";$("outcome").value="";$("honest").checked=false;}
function lock(payload,digest){frozen={payload,digest};$("task").value=payload.task.id;for(const k of fields)$(k).value=payload[k];$("ready").checked=true;disableFields(true);$("pin").textContent="Plan SHA-256: "+digest;$("saved").disabled=false;$("saved").checked=false;clearResults();details();update();}
async function hash(v){const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(JSON.stringify(v)));return Array.from(new Uint8Array(b),x=>x.toString(16).padStart(2,"0")).join("");}
function download(name,obj){const url=URL.createObjectURL(new Blob([JSON.stringify(obj,null,2)+"\n"],{type:"application/json"}));const a=document.createElement("a");a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
for(const k of fields)$(k).addEventListener("input",()=>{$("ready").checked=false;update();});
$("task").addEventListener("change",()=>{$("ready").checked=false;details();update();});
$("ready").addEventListener("change",update);
$("freeze").addEventListener("click",async()=>{if(busy||frozen||!complete()||!$("ready").checked)return;busy=true;disableFields(true);update();try{const payload={format:"mimirs-well-frozen-test-plan",version:1,created_at:new Date().toISOString(),run_id:crypto.randomUUID(),catalog_sha256:queue.catalog_sha256,queue_version:queue.version,task:task(),...Object.fromEntries(fields.map(k=>[k,$(k).value.trim()]))};const digest=await hash(payload);lock(payload,digest);download(payload.task.id+"-plan-"+payload.run_id+".json",frozen);status("Plan export requested. Confirm the file was saved before execution.");}catch(e){status("Freeze failed: "+e.message);if(!frozen)disableFields(false);}finally{busy=false;update();}});
$("reset").addEventListener("click",()=>{if(busy)return;if(!confirm("Discard current worksheet session? Export any needed receipts first."))return;frozen=null;disableFields(false);for(const k of fields)$(k).value="";$("ready").checked=false;$("saved").checked=false;$("saved").disabled=true;$("pin").textContent="";clearResults();status("New session.");update();});
$("open").addEventListener("click",()=>{if(!busy)$("import").click();});
$("import").addEventListener("change",async()=>{const f=$("import").files[0];$("import").value="";if(!f||busy)return;busy=true;update();try{if(f.size>2000000)throw Error("File too large");const v=JSON.parse(await f.text()),p=v?.payload;const expected=queue.tasks.find(t=>t.id===p?.task?.id);if(!p||p.format!=="mimirs-well-frozen-test-plan"||p.version!==1||p.queue_version!==queue.version||p.catalog_sha256!==queue.catalog_sha256||!expected||JSON.stringify(p.task)!==JSON.stringify(expected)||!fields.every(k=>typeof p[k]==="string"&&p[k].trim())||typeof p.run_id!=="string"||!Number.isFinite(Date.parse(p.created_at))||await hash(p)!==v.digest)throw Error("Plan is modified, incomplete or from a different queue version");if(!confirm("Replace the current session with this frozen plan?"))return;lock(p,v.digest);status("Plan digest and embedded task matched. This does not prove when it was frozen.");}catch(e){status("Plan not opened: "+e.message);}finally{busy=false;update();}});
$("saved").addEventListener("change",()=>{$("honest").checked=false;update();});
for(const k of ["outcome",...results])$(k).addEventListener("input",()=>{$("honest").checked=false;update();});
$("honest").addEventListener("change",update);
$("export").addEventListener("click",()=>{if($("export").disabled)return;download(frozen.payload.task.id+"-reported-"+frozen.payload.run_id+".json",{format:"mimirs-well-reported-test-run",version:1,reported_at:new Date().toISOString(),status:"reported-not-independently-verified",plan:frozen,plan_saved_before_outcomes_attested:true,outcome:$("outcome").value,...Object.fromEntries(results.map(k=>[k,$(k).value.trim()])),reporter_acknowledged:true});status("Reported-run export requested. Confirm file was saved; send for review separately.");});
window.addEventListener("beforeunload",e=>{if(frozen||fields.some(k=>$(k).value)){e.preventDefault();e.returnValue="";}});
details();update();
})();
</script></body></html>
