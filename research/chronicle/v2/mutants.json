[
  [
    "ignore-residual",
    "missing.length===0&&apparentResidual===0",
    "missing.length===0"
  ],
  [
    "ignore-missing",
    "missing.length===0&&apparentResidual===0",
    "apparentResidual===0"
  ],
  [
    "ledger-underaccepted",
    "closed:sum===c.input",
    "closed:sum<=c.input"
  ],
  [
    "constant-product-ratio",
    "productRatio:ratio(c.product,c.input)",
    "productRatio:0.6"
  ],
  [
    "events-use-failures",
    "eventRate:ratio(c.events,c.hours)",
    "eventRate:ratio(c.failed,c.hours)"
  ],
  [
    "failures-use-events",
    "failureFraction:ratio(c.failed,c.runs)",
    "failureFraction:ratio(c.events,c.runs)"
  ],
  [
    "wrong-ceiling",
    "ceiling=1-c.cold/c.hot",
    "ceiling=c.cold/c.hot-0.5"
  ],
  [
    "missing-as-zero",
    "keys.filter(k=>c[k]===null)",
    "keys.filter(k=>false)"
  ],
  [
    "unguarded-ratio",
    "d===0?null:n/d",
    "n/d"
  ],
  [
    "zero-default-ratio",
    "d===0?null:n/d",
    "d===0?0:n/d"
  ],
  [
    "deduplicate-transfers",
    "c.outputs.reduce((a,b)=>a+b,0)",
    "[...new Set(c.outputs)].reduce((a,b)=>a+b,0)"
  ],
  [
    "absolute-residual",
    "residual:c.input-sum",
    "residual:Math.abs(c.input-sum)"
  ],
  [
    "exclusive-bound",
    "c.work*c.hot<=c.heat*(c.hot-c.cold)",
    "c.work*c.hot<c.heat*(c.hot-c.cold)"
  ],
  [
    "always-permit",
    "c.work*c.hot<=c.heat*(c.hot-c.cold)",
    "true"
  ],
  [
    "never-permit",
    "c.work*c.hot<=c.heat*(c.hot-c.cold)",
    "false"
  ],
  [
    "celsius-bound",
    "ceiling=1-c.cold/c.hot",
    "ceiling=1-(c.cold-273.15)/(c.hot-273.15)"
  ],
  [
    "omit-inventory",
    "s+(c[k]===null?0:c[k])",
    "s+(k==='inventory'||c[k]===null?0:c[k])"
  ]
]
